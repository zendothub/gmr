# Local development environment (overrides .env.example)
DEBUG=false
SECRET_KEY=local-dev-secret-key-change-me

# Docker PostgreSQL is mapped to host port 5433 (local Homebrew Postgres owns 5432)
DATABASE_URL=postgresql+asyncpg://coal_mine_user:coal_mine_pass@localhost:5433/coal_mine_db
DATABASE_SYNC_URL=postgresql://coal_mine_user:coal_mine_pass@localhost:5433/coal_mine_db

# MinIO running in Docker, mapped to host port 9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=coal-mine

LOG_LEVEL=INFO

# SMTP / Email — feature-request notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abdur@zendot.in
SMTP_PASS=mvea xxwp vhdm ifez
SMTP_USE_TLS=true
SMTP_FROM=abdur@zendot.in
NOTIFICATION_EMAIL=tech@zendot.in

# CORS - Vercel frontend + ngrok tunnel (update ngrok URL after starting tunnel)
CORS_ORIGINS=https://gmr-frontend-nine.vercel.app,https://gmr-retaileye.bluecloudsoftech.com,http://localhost:3000,http://localhost:5173,http://172.17.73.76,http://172.17.73.76:3000,http://172.17.73.76:8000,http://172.17.73.76:8889,http://192.168.1.89:3000,http://10.69.154.89,http://10.69.154.89:80,http://10.69.154.89:3000,http://10.69.154.89:5173,http://10.69.154.89:8080

# MediaMTX public base URL (browser-accessible WebRTC/WHEP/HLS domain)
# Leave EMPTY for local LAN testing — URLs will be built from the requesting
# host IP + MediaMTX port (e.g. http://10.114.30.75:8889/cam_.../whep).
# Set to https://feed-retaileye.bluecloudsoftech.com only for cloud/EC2 deploy.
MEDIAMTX_PUBLIC_URL=http://192.168.1.17

# MinIO public base URL (browser-accessible assets domain)
# Use MINIO_PUBLIC_URL / MINIO_PUBLIC_ENDPOINT instead (see config.py)
