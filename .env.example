# Application
APP_NAME=RetailAIPlatform
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://retail_user:retail_pass@localhost:5432/retail_ai_db
DATABASE_SYNC_URL=postgresql://retail_user:retail_pass@localhost:5432/retail_ai_db

# Storage
STORAGE_ROOT=./storage
SNAPSHOT_DIR=snapshots
CROP_DIR=crops
CLIP_DIR=clips
REPORT_DIR=reports

# AI Models
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_ALLOWED_CLASSES=0
OSNET_MODEL_PATH=models/osnet_x1_0.pth
REID_EMBEDDING_DIM=512
REID_MATCH_THRESHOLD=0.78
REID_CROP_QUALITY_THRESHOLD=0.70

# Runtime
DEFAULT_FPS_TARGET=5
MAX_WORKERS=8
FRAME_BUFFER_SIZE=2
RUNTIME_SHOW_GUI=false

# Logging
LOG_LEVEL=INFO
