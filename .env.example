# Application
APP_NAME=RetailAIPlatform
APP_VERSION=1.0.0
DEBUG=true
# SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# DATABASE_URL=postgresql+asyncpg://retail_user:retail_pass@localhost:5433/retail_ai_db
# DATABASE_SYNC_URL=postgresql://retail_user:retail_pass@localhost:5433/retail_ai_db

# Storage — MinIO (S3-compatible object storage)
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false
# MINIO_BUCKET_PREFIX=retail
# Object-name prefixes for categorising blobs inside the bucket.
SNAPSHOT_DIR=snapshots
CROP_DIR=crops
CLIP_DIR=clips
REPORT_DIR=reports

# AI Models
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_ALLOWED_CLASSES=0
OSNET_MODEL_PATH=models/osnet_x1_0.pth
REID_EMBEDDING_DIM=512
REID_MATCH_THRESHOLD=0.60
REID_CROP_QUALITY_THRESHOLD=0.50
REID_ACCUMULATION_FRAMES=5
REID_CONFIDENCE_LIMIT=0.75
REID_MIN_QUALITY_FOR_SWITCH=0.80

# InsightFace (Face Recognition & Demographics)
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640,640
FACE_MATCH_THRESHOLD=0.55

# YOLO-Pose (Enhanced ReID Quality Assessment)
YOLO_POSE_MODEL_PATH=models/yolo11n-pose.pt
YOLO_POSE_CONFIDENCE=0.3

# Runtime
DEFAULT_FPS_TARGET=5
MAX_WORKERS=8
FRAME_BUFFER_SIZE=2
RUNTIME_SHOW_GUI=false

# Streaming (ffmpeg -> MediaMTX -> WebRTC/WHEP/HLS)
FFMPEG_BINARY=ffmpeg
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
# Public base URL the browser uses to reach MediaMTX (leave empty to derive host:port).
MEDIAMTX_PUBLIC_URL=
# copy = remux only (cheapest); lowlatency = re-encode for browser compatibility
STREAM_PUBLISH_MODE=copy
STREAM_IDLE_TIMEOUT_SECONDS=120
STREAM_PIPELINE_LOG=false
SNAPSHOT_TIMEOUT_SECONDS=10
SNAPSHOT_JPEG_QUALITY=85

# SMTP / Email (for feature-request notifications and other alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abdur@zendot.in
SMTP_PASS=mvea xxwp vhdm ifez
SMTP_USE_TLS=true
SMTP_FROM=abdur@zendot.in
NOTIFICATION_EMAIL=tech@zendot.in

# Logging
LOG_LEVEL=INFO

