# systemd unit for RetailEye Backend (retail-ai service)
# This service runs the FastAPI backend application
#
# Install:
#   sudo cp systemd/retail-ai.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now retail-ai.service

[Unit]
Description=Retail AI Platform (FastAPI Backend)
After=network.target postgresql.service 
Wants=postgresql.service

[Service]
Type=simple
User=retaileye
Group=retaileye
WorkingDirectory=/gmr/gmr
Environment="PATH=/gmr/gmr/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/gmr/gmr/.env

# Run database migrations before starting
ExecStartPre=/gmr/gmr/venv/bin/alembic upgrade head

# Wait for MediaMTX to be ready before starting (max 30s)
ExecStartPre=/bin/bash -c 'for i in {1..30}; do curl -sf http://localhost:9997/v1/paths > /dev/null 2>&1 && break; echo "Waiting for MediaMTX..."; sleep 1; done'

# Additional wait for MediaMTX to stabilize before starting backend
ExecStartPre=/bin/sleep 10

# Start the FastAPI application with uvicorn (--workers 1 because camera worker system uses in-process singletons)
ExecStart=/gmr/gmr/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

# Restart configuration
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Logging
StandardOutput=append:/gmr/gmr/logs/retail-ai.log
StandardError=append:/gmr/gmr/logs/retail-ai-error.log

# GPU device access for CUDA / ONNX Runtime inference
DeviceAllow=/dev/nvidia0
DeviceAllow=/dev/nvidiactl
DeviceAllow=/dev/nvidia-uvm
DeviceAllow=/dev/nvidia-uvm-tools
DeviceAllow=/dev/nvidia-modeset

# Security and resource limits
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

# Process priority — give AI pipeline higher scheduling priority
Nice=-5

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target